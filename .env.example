# Copy this file to .env.local (git-ignored) and fill in real values.
# NEVER commit real keys — especially the service-role key.

# -----------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser, so ONLY the public anon key here.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://dfdutbwayvvothcbqaur.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_UIcY7PH6E91WdasFV3q8ZQ_1SjFD0kA

# Admin email (must match your Supabase login and a row in the `admins` table).
VITE_ADMIN_EMAIL=ibraheem.aqamar@gmail.com

# Where the Node API lives. Leave as /api to use the same origin (Vite proxies
# it in dev). Set to a full URL only if the API is deployed on another host.
# VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Node/Express backend (server/) — server-side only, NEVER sent to the browser.
# -----------------------------------------------------------------------------
