{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__vpath=/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
